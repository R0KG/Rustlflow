DATABASE_URL=postgresql:///rustflow_dev
NATS_URL=nats://127.0.0.1:4222
RUST_LOG=rustflow=info
RUSTFLOW_LEASE_SECONDS=60
RUSTFLOW_TASK_TIMEOUT_SECONDS=45
RUSTFLOW_MAX_DELIVERIES=5
# Optional: enables OTLP trace export, for example http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
